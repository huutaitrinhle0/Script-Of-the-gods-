local function C()
    return LP.Character
end

local function Root()
    local c=C()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Hum()
    local c=C()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function Remote(names)
    for _,n in ipairs(names) do
        local x=R:FindFirstChild(n,true)
        if x and x:IsA("RemoteEvent") then
            return x
        end
    end
end

local function Pos(p)
    local x=p and p.Parent
    if not x then return end
    if x:IsA("Attachment") then return x.WorldPosition end
    if x:IsA("BasePart") then return x.Position end
    if x:IsA("Model") then return x:GetPivot().Position end
    local b=x:FindFirstChildWhichIsA("BasePart",true)
    return b and b.Position
end

