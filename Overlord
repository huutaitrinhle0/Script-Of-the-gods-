        Prompts[x]=true
    end
end

for _,x in ipairs(workspace:GetDescendants()) do
    AddPrompt(x)
end

workspace.DescendantAdded:Connect(AddPrompt)

workspace.DescendantRemoving:Connect(
    function(x)
        Prompts[x]=nil
    end
)

local function PromptCount()
    local n=0
    for p in pairs(Prompts) do
        if p.Parent then
            n+=1
        end
    end
    return n
end

local function TargetPrompt()

    local r=Root()
    if not r then return end

    local best,dist=nil,math.huge

    for p in pairs(Prompts) do

        if p.Parent and p.Enabled then

            local text=(
                p.Name.." "
                ..p.ActionText.." "
                ..p.ObjectText
            ):lower()

            if text:find("egg",1,true)
            or text:find("nest",1,true)
            or text:find("steal",1,true)
            or text:find("grab",1,true) then

                local pos=Pos(p)

                if pos then
                    local d=(r.Position-pos).Magnitude

                    if d<dist then
                        best,dist=p,d
                    end
                end
            end
        end
    end

    return best
end

local function Stop()

    Token+=1
    Farm=false

    if Tween then
        pcall(function()
            Tween:Cancel()
        end)
        Tween=nil
    end
end

local function Go(cf)

    local r=Root()
    if not r then return false end

    local d=(r.Position-cf.Position).Magnitude

    if d<=1 then
        r.CFrame=cf
        return true
    end

    local my=Token

    local ok,t=pcall(function()
        return T:Create(
            r,
            TweenInfo.new(
                math.max(
                    d/math.clamp(
                        tonumber(_G.TweenSpeed) or 150,
                        1,1000
                    ),
                    .05
                ),
                Enum.EasingStyle.Linear
            ),
            {CFrame=cf}
        )
    end)

    if not ok then return false end

    Tween=t

    local done=false
    local c=t.Completed:Connect(
        function()
            done=true
        end
    )

    t:Play()

    while
        Farm
        and my==Token
        and not done
    do
        task.wait()
    end

    c:Disconnect()

    if not done then
        pcall(function()
            t:Cancel()
        end)
    end

    Tween=nil
    return done
end

local function Activate(p)

    if not p
    or not p.Parent
    or not p.Enabled then
        return false
    end

    if type(fireproximityprompt)=="function" then
        local ok=pcall(function()
            fireproximityprompt(p)
        end)

        if ok then
            return true
        end
    end

    return pcall(function()
        p:InputHoldBegin()
        task.wait(
            math.max(p.HoldDuration,.05)+.05
        )
        p:InputHoldEnd()
    end)
end

local function Start()

    if Farm then return end

    Farm=true
    Token+=1

    local my=Token

    task.spawn(function()

        while Farm
        and _G.EggGom
        and my==Token do

            local p=TargetPrompt()

            if p then

                local pos=Pos(p)

                if pos and Go(
                    CFrame.new(
                        pos+Vector3.new(0,1.5,0)
                    )
                ) then

                    Activate(p)

                    task.wait(
                        math.max(
                            p.HoldDuration,
                            .1
                        )
                    )
                end

            else
                task.wait(.35)
            end
        end
    end)
end

