local G=W:CreateTab("🦖 Guard",4483362458)
local Weld

local function NearestGuard()
    local r=Root()
    if not r then return end

    local best,dist=nil,math.huge

    for _,m in ipairs(workspace:GetDescendants()) do
        if m:IsA("Model") then
            local n=m.Name:lower()

            if n:find("guard",1,true)
            or n:find("bodyguard",1,true) then

                local p=m.PrimaryPart
                    or m:FindFirstChild("HumanoidRootPart")

                if p and p:IsA("BasePart") then
                    local d=(r.Position-p.Position).Magnitude
                    if d<dist then
                        best,dist=m,d
                    end
                end
            end
        end
    end

    return best
end

