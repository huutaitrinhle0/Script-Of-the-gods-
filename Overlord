local function Diagnose(s)

    s=tostring(s):lower()

    if s=="" then
        return "Chưa có lỗi."

    elseif s:find("attempt to index nil",1,true) then
        return "Có object/biến nil."

    elseif s:find("invalid member",1,true) then
        return "Member/property không tồn tại."

    elseif s:find("infinite yield",1,true) then
        return "WaitForChild đang chờ object."

    elseif s:find("syntax",1,true)
    or s:find("expected",1,true) then
        return "Có khả năng lỗi cú pháp Luau."

    elseif s:find("fireserver",1,true) then
        return "Remote hoặc tham số không đúng."

    elseif s:find("httpget",1,true)
    or s:find("loadstring",1,true) then
        return "Kiểm tra URL/source."
    end

    return "Chưa nhận diện mẫu lỗi."
end

